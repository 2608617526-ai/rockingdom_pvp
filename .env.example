# ============================================================
#  洛克王国主宠PK —— 环境变量示例（复制为 .env 使用）
#  注意：真正的 .env 请根据部署环境分别放在 server/.env 与 client/.env
# ============================================================

# ---- 后端 (server/.env) ----
# 后端监听端口
PORT=3000

# 允许的前端来源（用于 Socket.IO 的 CORS 校验）
# 开发环境填 Vite 开发服务器地址；生产环境填你的域名
CLIENT_ORIGIN=http://localhost:5173

# 运行环境：development / production
NODE_ENV=development

# ---- 前端 (client/.env) ----
# 前端需要连接的 Socket.IO 服务器地址
# 开发环境：http://localhost:3000
# 生产环境：https://你的域名
VITE_SERVER_URL=http://localhost:3000
